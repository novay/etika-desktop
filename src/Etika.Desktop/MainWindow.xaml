<Window
    x:Class="Etika.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Etika.Core"
    Title="ETIKA Desktop">
    <Grid x:Name="Root" Loaded="Root_Loaded" RowDefinitions="Auto,*,Auto"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <InfoBar x:Name="ErrorBar" Grid.Row="0" IsOpen="False" Severity="Error" Margin="16,8" />
        <ScrollViewer x:Name="LoginPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="380" Spacing="18" Margin="24,40" HorizontalAlignment="Center">
                <TextBlock Text="ETIKA" FontSize="38" FontWeight="SemiBold" />
                <TextBlock Text="Ruang kerja verifikasi dokumen" FontSize="17"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox x:Name="ServerBox" Header="Server ETIKA" MaxLength="500"
                         Text="https://etika.kukarkab.com" />
                <TextBox x:Name="EmailBox" Header="Email" MaxLength="255" />
                <PasswordBox x:Name="PasswordBox" Header="Kata sandi" MaxLength="1024" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image x:Name="CaptchaImage" Width="180" Height="60" Stretch="Uniform"
                           AutomationProperties.Name="Gambar kode verifikasi" />
                    <Button Content="Ganti kode" Click="Challenge_Click" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="CaptchaBox" Header="Kode verifikasi" MaxLength="30" />
                <CheckBox x:Name="RememberBox" Content="Ingat sesi di perangkat ini" />
                <Button x:Name="LoginButton" Content="Masuk" Click="Login_Click"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                <TextBlock Text="Gunakan akun yang sama dengan ETIKA web." TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="Workspace" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid ColumnDefinitions="240,*">
            <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="24">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                    <TextBlock Text="ETIKA" FontSize="28" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,28,0,24">
                        <TextBlock x:Name="UserName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="UserRole" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="YearBox" Grid.Row="2" Header="Tahun anggaran"
                              DisplayMemberPath="Tahun" HorizontalAlignment="Stretch"
                              SelectionChanged="Year_Changed" />
                    <TextBlock Grid.Row="3" Text="Dokumen" Margin="0,24,0,12" FontWeight="SemiBold" FontSize="18" />
                    <Button Grid.Row="4" Content="Muat ulang" Click="Refresh_Click" HorizontalAlignment="Stretch" />
                    <Button Grid.Row="6" Content="Keluar" Click="Logout_Click" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
            <Grid Grid.Column="1" Padding="24" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dokumen" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Buka dokumen dan lampiran sesuai kewenangan Anda."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,20,0,16">
                    <TextBox x:Name="SearchBox" PlaceholderText="Cari kode atau nama subkegiatan" MaxLength="150"
                             KeyDown="Search_KeyDown" />
                    <Button Grid.Column="1" Content="Cari" Click="Search_Click" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock x:Name="EmptyState" Text="Belum ada dokumen untuk pilihan ini."
                                   TextWrapping="Wrap" Margin="8,12" Visibility="Collapsed" />
                        <ListView x:Name="DocumentsList" Grid.Row="1" SelectionChanged="Document_Changed"
                                  SelectionMode="Single" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:DocumentSummary">
                                    <StackPanel Spacing="6" Padding="8,12">
                                        <TextBlock Text="{x:Bind DisplayTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind DisplaySubtitle}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayPagu}" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel x:Name="DetailPanel" Spacing="16" Padding="12,8">
                            <TextBlock x:Name="DetailTitle" Text="Pilih dokumen" FontSize="22"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSubtitle" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailStatus" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailBudget" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="Lampiran PDF" FontWeight="SemiBold" FontSize="16" />
                            <ItemsControl x:Name="AttachmentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:Attachment">
                                        <Button Content="{x:Bind Nama}" Tag="{x:Bind Id}" Click="Attachment_Click"
                                                Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                    <Button x:Name="PreviousButton" Content="Sebelumnya" Click="Previous_Click" />
                    <TextBlock x:Name="PageLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" Grid.Column="2" Content="Berikutnya" Click="Next_Click" />
                </Grid>
            </Grid>
        </Grid>
        </ContentControl>
        <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</Window>
