<Window x:Class="Etika.Desktop.SubmissionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pengajuan SKPD — ETIKA">
 <Grid x:Name="Root" Loaded="Root_Loaded" RowDefinitions="Auto,Auto,*,Auto" Padding="24" RowSpacing="16">
  <StackPanel Spacing="4">
   <TextBlock x:Name="Heading" Text="Pengajuan dokumen" FontSize="26" FontWeight="SemiBold" />
   <TextBlock x:Name="ContextText" TextWrapping="Wrap" />
  </StackPanel>
  <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="FormPanel" Spacing="16">
    <StackPanel x:Name="SubPicker" Spacing="8">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="SearchBox" PlaceholderText="Cari kode atau nama subkegiatan" MaxLength="150" AutomationProperties.Name="Cari subkegiatan" />
      <Button Grid.Column="1" Content="Cari" Click="Search_Click" />
     </Grid>
     <ListView x:Name="SubList" Height="140" DisplayMemberPath="Display" SelectionChanged="Sub_Changed" AutomationProperties.Name="Subkegiatan pengajuan" />
     <Grid ColumnDefinitions="Auto,*,Auto">
      <Button x:Name="PreviousButton" Content="Sebelumnya" Click="Previous_Click" />
      <TextBlock x:Name="PageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Button x:Name="NextButton" Grid.Column="2" Content="Berikutnya" Click="Next_Click" />
     </Grid>
    </StackPanel>
    <TextBlock x:Name="SelectedSubText" TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock x:Name="PpasText" TextWrapping="Wrap" />
    <InfoBar x:Name="RevisionBar" IsOpen="False" Severity="Warning" Title="Catatan revisi" IsClosable="False" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
     <CalendarDatePicker x:Name="DateBox" Header="Tanggal penyerahan" HorizontalAlignment="Stretch" />
     <TimePicker x:Name="TimeBox" Grid.Column="1" Header="Waktu penyerahan (WITA)" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
    </Grid>
    <ComboBox x:Name="CategoryBox" Header="Kategori" HorizontalAlignment="Stretch" SelectionChanged="Category_Changed" AutomationProperties.Name="Kategori pengajuan" />
    <ComboBox x:Name="FinancingBox" Header="Jenis pembiayaan" HorizontalAlignment="Stretch" Visibility="Collapsed" AutomationProperties.Name="Jenis pembiayaan" />
    <TextBox x:Name="BudgetBox" Header="Pagu RKA (rupiah bulat)" PlaceholderText="Contoh: 1.250.000" MaxLength="19" AutomationProperties.AutomationId="SubmissionBudget" />
    <TextBox x:Name="NotesBox" Header="Keterangan (opsional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxLength="10000" />
    <TextBlock Text="Lampiran PDF" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Maksimal 5.000 KB per berkas dan 25 MB per pengiriman. Lampiran bertanda * wajib diisi. Pilih PDF baru untuk mengganti lampiran yang tersimpan." TextWrapping="Wrap" />
    <StackPanel x:Name="FilesPanel" Spacing="12" />
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Spacing="10">
   <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
   <TextBlock x:Name="StateText" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="SaveButton" Content="Kirim pengajuan" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.AutomationId="SubmitDocument" />
    <Button x:Name="ResubmitButton" Content="Kirim ulang" Visibility="Collapsed" Click="Resubmit_Click" />
    <Button x:Name="RetryButton" Content="Coba lagi" Visibility="Collapsed" Click="Retry_Click" />
    <Button x:Name="CancelButton" Content="Batalkan permintaan" Visibility="Collapsed" Click="Cancel_Click" />
    <Button Content="Tutup" Click="Close_Click" />
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
